#!/bin/sh
# Block direct pushes to main. Changes reach main only via a pull request.
# Owner override (discouraged): git push --no-verify

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "$protected" ]; then
		echo "✖ Direct pushes to 'main' are blocked by policy (see AGENTS.md)." >&2
		echo "  Push a feature branch and open a pull request instead." >&2
		echo "  To override (owner only): git push --no-verify" >&2
		exit 1
	fi
done

exit 0
